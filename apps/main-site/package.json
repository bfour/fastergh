{
	"name": "@packages/main-site",
	"version": "0.1.0",
	"type": "module",
	"private": true,
	"scripts": {
		"with-env": "dotenv -e ../../.env --",
		"with-env:prod": "dotenv -e ../../.env.production.vercel --",
		"dev": "NODE_ENV=development pnpm with-env next dev --turbo ${REMOTE_DEV:+-H 0.0.0.0} --port 4007",
		"dev:prod": "NODE_ENV=development pnpm with-env:prod next dev --turbo --port 4007",
		"build": "pnpm with-env next build",
		"start": "pnpm with-env next start",
		"typecheck": "tsgo --noEmit",
		"typecheck:slow": "tsc --noEmit",
		"test": "vitest run --passWithNoTests --pool=forks",
		"clean": "rm -rf node_modules .next"
	},
	"dependencies": {
		"@convex-dev/better-auth": "catalog:",
		"@effect-atom/atom": "catalog:",
		"@effect-atom/atom-react": "catalog:",
		"@monaco-editor/react": "4.7.0",
		"@packages/confect": "workspace:*",
		"@packages/database": "workspace:*",
		"@packages/react": "workspace:*",
		"@packages/ui": "workspace:*",
		"@pierre/diffs": "1.0.11",
		"@sentry/nextjs": "9.47.1",
		"@tanstack/hotkeys": "0.1.3",
		"@tanstack/react-hotkeys": "0.1.3",
		"@vercel/speed-insights": "1.3.1",
		"@vercel/toolbar": "0.1.41",
		"babel-plugin-react-compiler": "19.1.0-rc.1-rc-af1b7da-20250421",
		"better-auth": "catalog:",
		"convex": "catalog:",
		"effect": "catalog:",
		"lucide-react": "catalog:",
		"monaco-editor": "0.55.1",
		"next": "catalog:",
		"next-themes": "0.4.6",
		"nuqs": "catalog:",
		"posthog-js": "1.352.0",
		"posthog-node": "5.24.17",
		"react": "catalog:",
		"react-dom": "catalog:",
		"server-only": "0.0.1",
		"streamdown": "2.2.0"
	},
	"devDependencies": {
		"@packages/convex-test": "workspace:*",
		"@packages/typescript-config": "workspace:*",
		"@tailwindcss/postcss": "catalog:",
		"@testing-library/dom": "10.4.1",
		"@testing-library/react": "16.3.2",
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"dotenv-cli": "10.0.0",
		"happy-dom": "20.0.11",
		"postcss": "catalog:",
		"tailwindcss": "catalog:",
		"vitest": "catalog:"
	}
